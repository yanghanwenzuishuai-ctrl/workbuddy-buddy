NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Set only when the service is behind a known number of trusted reverse proxies.
TRUST_PROXY_HOPS=0
DATABASE_URL=postgres://workbuddy:workbuddy@127.0.0.1:5432/workbuddy
DATABASE_SSL=false
# DATABASE_SSL_CA=<PEM certificate contents; this is not a file path>
MIGRATE_ON_START=true
ALLOW_UNVERIFIED_FAKE_EDGE=false
PRESENCE_LEASE_TTL_SECONDS=90
LEASE_SWEEP_INTERVAL_SECONDS=5
PUBLIC_REPLAY_MAX_REVISIONS=256
PUBLIC_RETENTION_INTERVAL_SECONDS=60
PUBLIC_PROJECTION_TICK_SECONDS=30
MAX_REQUEST_BYTES=131072
