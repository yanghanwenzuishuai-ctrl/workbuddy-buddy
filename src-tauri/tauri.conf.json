{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "workbuddy-buddy",
  "version": "0.0.1",
  "identifier": "dev.workbuddy.buddy",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "pet",
        "url": "index.html?embed=1",
        "title": "workbuddy-buddy",
        "width": 320,
        "height": 420,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ]
  }
}